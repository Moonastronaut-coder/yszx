# 复制为项目根目录 .env 后填写；真实 .env 已由 .gitignore 排除。
# 密码请使用不同的随机值（建议至少 24 位）；包含 $ 或 # 时使用单引号包住整个值。
# 本文件留空的五个密码是必填项，缺失时 Compose 会拒绝解析。

MYSQL_PORT=13306
MYSQL_DATABASE=yunshu_zhixue
MYSQL_USER=yunshu_app
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

REDIS_PORT=16379
REDIS_PASSWORD=
# 开发环境起始值，不是生产容量承诺；noeviction 达到上限会拒绝新增写入。
REDIS_MAXMEMORY=256mb

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=yunshu_admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=yunshu-assets
MINIO_APP_ACCESS_KEY=yunshu_storage_app
MINIO_APP_SECRET_KEY=

# 后端开发参数；使用 scripts/dev.mjs 启动时自动读取根目录 .env。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
MYSQL_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
SESSION_TIMEOUT=30m
SECURE_COOKIES=false
# 基础工程不执行业务表迁移，业务模块落地时再显式开启。
FLYWAY_ENABLED=false
