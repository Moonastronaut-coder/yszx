{
  "name": "@yunshu/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:portal": "pnpm --filter @yunshu/portal dev",
    "dev:admin": "pnpm --filter @yunshu/admin dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "build": "pnpm --filter @yunshu/portal --filter @yunshu/admin build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
